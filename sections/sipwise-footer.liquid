</div>

<!-- Accordion JS (mobile only) -->
<script>
  (function() {
    var footer = document.getElementById('sw-footer-{{ section.id }}');
    if (!footer) return;
    var items = footer.querySelectorAll('[data-swf-accordion]');
    items.forEach(function(item) {
      var btn = item.querySelector('.swf-acc-toggle');
      var panel = item.querySelector('.swf-acc-links');
      if (!btn || !panel) return;
      btn.addEventListener('click', function() {
        var isOpen = item.classList.contains('is-open');
        items.forEach(function(i) {
          i.classList.remove('is-open');
          var b = i.querySelector('.swf-acc-toggle');
          var p = i.querySelector('.swf-acc-links');
          if (b) b.setAttribute('aria-expanded', 'false');
          if (p) p.setAttribute('aria-hidden', 'true');
        });
        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          panel.setAttribute('aria-hidden', 'false');
        }
      });
    });
  })();
</script>

