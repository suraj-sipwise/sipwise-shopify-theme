{% comment %} sections/sipwise-footer.liquid {% endcomment %}
{% comment %}
  Sipwise Concise Footer
  Mobile: collapsible accordion with + toggle.
  Desktop: 4-column layout — headings top, links below.
  Logo + tagline bottom-left. Copyright bar spans full bottom.
  Each nav block supports a Shopify menu OR up to 8 individual text+link pairs.
  Figtree font enforced. All colors, sizes, spacing fully customizable.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700;1,900&display=swap" rel="stylesheet">

<style>
  #sw-footer-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    {%- if section.settings.bg_image != blank -%}
    background-image: url('{{ section.settings.bg_image | image_url: width: 2400 }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    {%- endif -%}
    font-family: 'Figtree', sans-serif;
    color: {{ section.settings.text_color }};
    box-sizing: border-box;
  }

  #sw-footer-{{ section.id }} * {
    font-family: 'Figtree', sans-serif !important;
    box-sizing: border-box;
  }

  #sw-footer-{{ section.id }} .swf-outer {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.h_padding }}px;
  }

  /* =============================
     TOP NAV AREA
     ============================= */
  #sw-footer-{{ section.id }} .swf-nav-area {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.nav_padding_bottom }}px;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  /* Desktop: grid of columns */
  #sw-footer-{{ section.id }} .swf-nav-grid {
    display: none;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr){% if section.settings.app_store_url != blank or section.settings.play_store_url != blank %} minmax(180px, 1.2fr){% endif %};
    gap: {{ section.settings.column_gap }}px;
    align-items: start;
  }

  @media screen and (min-width: 750px) {
    #sw-footer-{{ section.id }} .swf-nav-grid {
      display: grid;
    }
    #sw-footer-{{ section.id }} .swf-nav-accordion {
      display: none;
    }
  }

  /* Column heading */
  #sw-footer-{{ section.id }} .swf-col-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_gap }}px 0;
    line-height: 1.2;
    letter-spacing: 0;
  }

  /* Links */
  #sw-footer-{{ section.id }} .swf-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.link_gap }}px;
  }

  #sw-footer-{{ section.id }} .swf-link-list a {
    font-size: {{ section.settings.link_size }}px;
    font-weight: {{ section.settings.link_weight }};
    color: {{ section.settings.link_color }};
    text-decoration: none;
    line-height: 1.4;
    display: block;
    transition: color 0.2s ease;
  }

  #sw-footer-{{ section.id }} .swf-link-list a:hover {
    color: {{ section.settings.link_hover_color }};
  }

  /* =============================
     MOBILE ACCORDION
     ============================= */
  #sw-footer-{{ section.id }} .swf-nav-accordion {
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  #sw-footer-{{ section.id }} .swf-acc-item {
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  #sw-footer-{{ section.id }} .swf-acc-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    padding: {{ section.settings.accordion_padding }}px 0;
    color: {{ section.settings.heading_color }};
    text-align: left;
  }

  #sw-footer-{{ section.id }} .swf-acc-heading {
    font-size: {{ section.settings.acc_heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.2;
  }

  #sw-footer-{{ section.id }} .swf-acc-icon {
    font-size: 22px;
    font-weight: 300;
    color: {{ section.settings.link_color }};
    flex-shrink: 0;
    transition: transform 0.25s ease;
    line-height: 1;
    width: 24px;
    text-align: center;
    user-select: none;
  }

  #sw-footer-{{ section.id }} .swf-acc-item.is-open .swf-acc-icon {
    transform: rotate(45deg);
  }

  #sw-footer-{{ section.id }} .swf-acc-links {
    display: none;
    padding-bottom: {{ section.settings.accordion_padding }}px;
  }

  #sw-footer-{{ section.id }} .swf-acc-item.is-open .swf-acc-links {
    display: block;
  }

  /* =============================
     BOTTOM BRAND + COPYRIGHT ROW
     ============================= */
  #sw-footer-{{ section.id }} .swf-bottom-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: {{ section.settings.brand_padding_top }}px 0 {{ section.settings.brand_padding_bottom }}px 0;
  }

  /* Logo area */
  #sw-footer-{{ section.id }} .swf-brand {
    flex-shrink: 0;
  }

  #sw-footer-{{ section.id }} .swf-logo-link {
    display: inline-block;
    text-decoration: none;
    margin-bottom: {{ section.settings.tagline_gap }}px;
  }

  #sw-footer-{{ section.id }} .swf-logo-img {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    display: block;
  }

  #sw-footer-{{ section.id }} .swf-logo-text {
    font-size: {{ section.settings.logo_text_size }}px;
    font-weight: 900;
    color: {{ section.settings.logo_text_color }};
    letter-spacing: -0.03em;
    line-height: 1;
    display: block;
    margin-bottom: {{ section.settings.tagline_gap }}px;
    text-decoration: none;
  }

  #sw-footer-{{ section.id }} .swf-tagline {
    font-size: {{ section.settings.tagline_size }}px;
    font-weight: {{ section.settings.tagline_weight }};
    color: {{ section.settings.tagline_color }};
    display: block;
    line-height: 1.3;
  }

  /* Social icons */
  #sw-footer-{{ section.id }} .swf-social {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  #sw-footer-{{ section.id }} .swf-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.social_size }}px;
    height: {{ section.settings.social_size }}px;
    border-radius: 50%;
    background: {{ section.settings.social_bg }};
    color: {{ section.settings.social_color }};
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  #sw-footer-{{ section.id }} .swf-social a:hover {
    opacity: 0.75;
    transform: translateY(-2px);
  }

  #sw-footer-{{ section.id }} .swf-social svg {
    width: calc({{ section.settings.social_size }}px * 0.48);
    height: calc({{ section.settings.social_size }}px * 0.48);
    fill: {{ section.settings.social_color }};
    display: block;
  }

  /* Copyright area (right side on desktop) */
  #sw-footer-{{ section.id }} .swf-copyright-area {
    text-align: right;
    font-size: {{ section.settings.copyright_size }}px;
    color: {{ section.settings.copyright_color }};
    line-height: 1.7;
  }

  #sw-footer-{{ section.id }} .swf-copyright-area a {
    color: {{ section.settings.copyright_color }};
    text-decoration: none;
    font-size: {{ section.settings.copyright_size }}px;
    transition: opacity 0.2s;
  }

  #sw-footer-{{ section.id }} .swf-copyright-area a:hover {
    opacity: 0.7;
  }

  #sw-footer-{{ section.id }} .swf-policy-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    justify-content: flex-end;
    list-style: none;
    margin: 4px 0 0 0;
    padding: 0;
  }

  #sw-footer-{{ section.id }} .swf-policy-list li a {
    font-size: {{ section.settings.copyright_size }}px;
    color: {{ section.settings.copyright_color }};
    text-decoration: none;
  }

  #sw-footer-{{ section.id }} .swf-policy-list li a:hover {
    opacity: 0.7;
  }

  /* Payment icons */
  #sw-footer-{{ section.id }} .swf-payment {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
    margin-top: 8px;
  }

  #sw-footer-{{ section.id }} .swf-payment .icon--full-color {
    height: 22px;
    width: auto;
    border-radius: 4px;
  }

  /* ---- Payment Bar (centered row) ---- */
  #sw-footer-{{ section.id }} .swf-payment-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    padding: {{ section.settings.payment_bar_padding }}px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  #sw-footer-{{ section.id }} .swf-payment-bar .icon--full-color {
    height: {{ section.settings.payment_icon_height }}px;
    width: auto;
    border-radius: 4px;
  }

  /* ---- App Download Column ---- */
  #sw-footer-{{ section.id }} .swf-app-col {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.app_align | default: 'center' }};
    text-align: {{ section.settings.app_align | default: 'center' }};
  }

  #sw-footer-{{ section.id }} .swf-app-heading {
    font-size: {{ section.settings.app_heading_size | default: 14 }}px;
    font-weight: {{ section.settings.app_heading_weight | default: 700 }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_gap }}px 0;
    line-height: 1.2;
    text-align: {{ section.settings.app_align | default: 'center' }};
    width: 100%;
  }

  #sw-footer-{{ section.id }} .swf-app-logo-wrap {
    display: flex;
    justify-content: {{ section.settings.app_align | default: 'center' }};
    align-items: center;
    width: 100%;
    margin-bottom: 14px;
  }

  #sw-footer-{{ section.id }} .swf-app-logo {
    max-width: {{ section.settings.app_logo_width }}px;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: {{ section.settings.app_logo_radius | default: 16 }}px;
  }

  #sw-footer-{{ section.id }} .swf-app-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: {{ section.settings.app_align | default: 'center' }};
    align-items: center;
    width: 100%;
  }

  #sw-footer-{{ section.id }} .swf-app-btn {
    display: inline-block;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #sw-footer-{{ section.id }} .swf-app-btn:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  #sw-footer-{{ section.id }} .swf-app-btn img {
    height: {{ section.settings.app_btn_height }}px;
    width: auto;
    display: block;
    border-radius: 6px;
  }

  /* Mobile: app section inside accordion */
  #sw-footer-{{ section.id }} .swf-app-mobile {
    padding: {{ section.settings.accordion_padding }}px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #sw-footer-{{ section.id }} .swf-app-mobile .swf-app-logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: 14px;
  }

  #sw-footer-{{ section.id }} .swf-app-mobile .swf-app-logo {
    margin: 0 auto;
  }

  #sw-footer-{{ section.id }} .swf-app-mobile .swf-app-buttons {
    justify-content: center;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    #sw-footer-{{ section.id }} .swf-app-mobile {
      display: none;
    }
  }

  /* Centered bottom row (matching Screenshot 2) */
  #sw-footer-{{ section.id }} .swf-bottom-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: {{ section.settings.brand_padding_top }}px 0 {{ section.settings.brand_padding_bottom }}px 0;
  }

  #sw-footer-{{ section.id }} .swf-copyright-centered {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 6px;
    font-size: {{ section.settings.copyright_size }}px;
    color: {{ section.settings.copyright_color }};
    text-align: center;
    line-height: 1.6;
  }

  #sw-footer-{{ section.id }} .swf-copyright-centered a {
    color: {{ section.settings.copyright_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #sw-footer-{{ section.id }} .swf-copyright-centered a:hover {
    opacity: 0.75;
  }

  #sw-footer-{{ section.id }} .swf-dot {
    opacity: 0.4;
    margin: 0 4px;
  }

  @media screen and (max-width: 749px) {
    #sw-footer-{{ section.id }} .swf-app-col {
      display: none;
    }
  }
</style>

<div class="content-for-grouping">
<footer id="sw-footer-{{ section.id }}" class="sipwise-footer" role="contentinfo">

  {%- assign nav_blocks = section.blocks | where: "type", "nav_group" -%}

  <div class="swf-outer">
    <div class="swf-nav-area">

      <!-- ===== DESKTOP GRID ===== -->
      {%- if nav_blocks.size > 0 -%}
        <div class="swf-nav-grid">
          {%- for block in nav_blocks -%}
            <div class="swf-nav-col swf-nav-col-{{ block.id }}" {{ block.shopify_attributes }}>
              <style>
                .swf-col-heading-{{ block.id }} {
                  {% if block.settings.heading_size != blank %}font-size: {{ block.settings.heading_size }}px !important;{% endif %}
                  {% if block.settings.heading_weight != blank %}font-weight: {{ block.settings.heading_weight }} !important;{% endif %}
                  {% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }} !important;{% endif %}
                }
                .swf-nav-col-{{ block.id }} .swf-link-list a,
                .swf-acc-item-{{ block.id }} .swf-link-list a {
                  {% if block.settings.link_size != blank %}font-size: {{ block.settings.link_size }}px !important;{% endif %}
                  {% if block.settings.link_weight != blank %}font-weight: {{ block.settings.link_weight }} !important;{% endif %}
                  {% if block.settings.link_color != blank %}color: {{ block.settings.link_color }} !important;{% endif %}
                }
                .swf-acc-heading-{{ block.id }} {
                  {% if block.settings.heading_size != blank %}font-size: {{ block.settings.heading_size }}px !important;{% endif %}
                  {% if block.settings.heading_weight != blank %}font-weight: {{ block.settings.heading_weight }} !important;{% endif %}
                  {% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }} !important;{% endif %}
                }
              </style>
              {%- if block.settings.heading != blank -%}
                <h3 class="swf-col-heading swf-col-heading-{{ block.id }}">{{ block.settings.heading }}</h3>
              {%- endif -%}

              <ul class="swf-link-list">
                {%- comment -%} Shopify menu links first if set {%- endcomment -%}
                {%- if block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- endif -%}

                {%- comment -%} Then individual custom links {%- endcomment -%}
                {%- for i in (1..8) -%}
                  {%- assign text_key = "link_" | append: i | append: "_text" -%}
                  {%- assign url_key  = "link_" | append: i | append: "_url" -%}
                  {%- if block.settings[text_key] != blank -%}
                    <li>
                      <a href="{{ block.settings[url_key] | default: '#' }}">
                        {{ block.settings[text_key] }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}

          {%- comment -%} App Download Column (Desktop top-right column inside grid) {%- endcomment -%}
          {%- if section.settings.app_store_url != blank or section.settings.play_store_url != blank -%}
            <div class="swf-app-col">
              {%- if section.settings.app_heading != blank -%}
                <h3 class="swf-app-heading">{{ section.settings.app_heading }}</h3>
              {%- endif -%}
              {%- if section.settings.app_logo != blank -%}
                <div class="swf-app-logo-wrap">
                  <img class="swf-app-logo" src="{{ section.settings.app_logo | image_url: width: 400 }}" alt="App" loading="lazy">
                </div>
              {%- endif -%}
              <div class="swf-app-buttons">
                {%- if section.settings.app_store_url != blank -%}
                  <a href="{{ section.settings.app_store_url }}" class="swf-app-btn" target="_blank" rel="noopener" aria-label="Download on App Store">
                    {%- if section.settings.app_store_image != blank -%}
                      <img src="{{ section.settings.app_store_image | image_url: height: 100 }}" alt="App Store">
                    {%- else -%}
                      <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="App Store">
                    {%- endif -%}
                  </a>
                {%- endif -%}
                {%- if section.settings.play_store_url != blank -%}
                  <a href="{{ section.settings.play_store_url }}" class="swf-app-btn" target="_blank" rel="noopener" aria-label="Get it on Google Play">
                    {%- if section.settings.play_store_image != blank -%}
                      <img src="{{ section.settings.play_store_image | image_url: height: 100 }}" alt="Google Play">
                    {%- else -%}
                      <img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg" alt="Google Play">
                    {%- endif -%}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        <!-- ===== MOBILE ACCORDION ===== -->
        <nav class="swf-nav-accordion" aria-label="Footer navigation">
          {%- for block in nav_blocks -%}
            <div class="swf-acc-item swf-acc-item-{{ block.id }}" data-swf-accordion {{ block.shopify_attributes }}>
              <button class="swf-acc-toggle" type="button" aria-expanded="false">
                <span class="swf-acc-heading swf-acc-heading-{{ block.id }}">{{ block.settings.heading }}</span>
                <span class="swf-acc-icon" aria-hidden="true">+</span>
              </button>
              <div class="swf-acc-links" aria-hidden="true">
                <ul class="swf-link-list">
                  {%- if block.settings.menu != blank -%}
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  {%- endif -%}
                  {%- for i in (1..8) -%}
                    {%- assign text_key = "link_" | append: i | append: "_text" -%}
                    {%- assign url_key  = "link_" | append: i | append: "_url" -%}
                    {%- if block.settings[text_key] != blank -%}
                      <li><a href="{{ block.settings[url_key] | default: '#' }}">{{ block.settings[text_key] }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endfor -%}
        </nav>

        {%- comment -%} App section for mobile {%- endcomment -%}
        {%- if section.settings.app_store_url != blank or section.settings.play_store_url != blank -%}
          <div class="swf-app-mobile">
            {%- if section.settings.app_heading != blank -%}
              <h3 class="swf-app-heading">{{ section.settings.app_heading }}</h3>
            {%- endif -%}
            {%- if section.settings.app_logo != blank -%}
              <div class="swf-app-logo-wrap">
                <img class="swf-app-logo" src="{{ section.settings.app_logo | image_url: width: 400 }}" alt="App" loading="lazy">
              </div>
            {%- endif -%}
            <div class="swf-app-buttons">
              {%- if section.settings.app_store_url != blank -%}
                <a href="{{ section.settings.app_store_url }}" class="swf-app-btn" target="_blank" rel="noopener">
                  {%- if section.settings.app_store_image != blank -%}
                    <img src="{{ section.settings.app_store_image | image_url: height: 100 }}" alt="App Store">
                  {%- else -%}
                    <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="App Store">
                  {%- endif -%}
                </a>
              {%- endif -%}
              {%- if section.settings.play_store_url != blank -%}
                <a href="{{ section.settings.play_store_url }}" class="swf-app-btn" target="_blank" rel="noopener">
                  {%- if section.settings.play_store_image != blank -%}
                    <img src="{{ section.settings.play_store_image | image_url: height: 100 }}" alt="Google Play">
                  {%- else -%}
                    <img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg" alt="Google Play">
                  {%- endif -%}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>{%- comment -%} end .swf-nav-area {%- endcomment -%}

    <!-- ===== PAYMENT BAR (centered) ===== -->
    {%- if section.settings.payment_enable -%}
      <div class="swf-payment-bar">
        {%- assign enabled_payment_types = shop.enabled_payment_types -%}
        {%- if section.settings.enabled_payment_types != blank -%}
          {%- assign enabled_payment_types = section.settings.enabled_payment_types | remove: ' ' | split: ',' -%}
        {%- endif -%}
        {%- for type in enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- ===== BOTTOM ROW: Copyright + Policies centered ===== -->
    <div class="swf-bottom-row">

      {%- if section.settings.show_brand -%}
        <!-- Brand: logo + tagline + social -->
        <div class="swf-brand">
          {%- if section.settings.logo_image != blank -%}
            <a href="{{ routes.root_url }}" class="swf-logo-link">
              <img
                class="swf-logo-img"
                src="{{ section.settings.logo_image | image_url: height: 120 }}"
                alt="{{ shop.name | escape }}"
                loading="lazy"
                width="{{ section.settings.logo_image.width }}"
                height="{{ section.settings.logo_image.height }}"
              >
            </a>
          {%- elsif section.settings.logo_text != blank -%}
            <a href="{{ routes.root_url }}" class="swf-logo-text">{{ section.settings.logo_text }}</a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="swf-logo-text">{{ shop.name }}</a>
          {%- endif -%}

          {%- if section.settings.tagline != blank -%}
            <span class="swf-tagline">{{ section.settings.tagline }}</span>
          {%- endif -%}

          <!-- Social icons -->
          {%- liquid
            assign has_social = false
