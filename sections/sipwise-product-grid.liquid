<!-- =======================================================
     INTERACTIVE JAVASCRIPT: FILTERING, SORTING & CART
     ======================================================= -->
<script>
  (function() {
    var section = document.getElementById('sipwise-shop-{{ section_id }}');
    if (!section) return;

    var grid = section.querySelector('#swp-product-grid-{{ section_id }}');
    var countEl = section.querySelector('#swp-count-num-{{ section_id }}');
    var activeTagsContainer = section.querySelector('#swp-active-tags-{{ section_id }}');
    var collTrack = section.querySelector('#swp-coll-track-{{ section_id }}');
    var dotsContainer = section.querySelector('#swp-coll-dots-{{ section_id }}');
    var inStockCheckbox = section.querySelector('#swp-instock-{{ section_id }}');
    var sortLabel = section.querySelector('.swp-sort-label');
    var collFilterLabel = section.querySelector('.swp-coll-filter-label');
    var colorFilterLabel = section.querySelector('.swp-color-filter-label');

    var currentFilters = {
      coll: 'all',
      color: 'all',
      inStockOnly: false,
      sort: 'featured'
    };

    // 1. Mobile Collections Carousel Dots
    if (collTrack && dotsContainer) {
      var cards = collTrack.querySelectorAll('.swp-coll-card');
      dotsContainer.innerHTML = '';
      cards.forEach(function(_, idx) {
        var dot = document.createElement('span');
        dot.className = 'swp-coll-dot' + (idx === 0 ? ' is-active' : '');
        dotsContainer.appendChild(dot);
      });

      collTrack.addEventListener('scroll', function() {
        var cardWidth = cards[0] ? cards[0].offsetWidth + 20 : 200;
        var activeIndex = Math.round(collTrack.scrollLeft / cardWidth);
        var dots = dotsContainer.querySelectorAll('.swp-coll-dot');
        dots.forEach(function(d, i) {
          d.classList.toggle('is-active', i === activeIndex);
        });
      });
    }

    // 2. Collection Cards Click -> Filter Grid or Navigate URL
    var collCards = section.querySelectorAll('.swp-coll-card');
    collCards.forEach(function(card) {
      card.addEventListener('click', function(e) {
        var action = card.getAttribute('data-card-action');
        var targetUrl = card.getAttribute('data-url');

        if (action === 'link' && targetUrl && targetUrl !== '#') {
          window.location.href = targetUrl;
          return;
        }

        e.preventDefault();
        var targetColl = (card.getAttribute('data-filter-coll') || 'all').toLowerCase();
        
        collCards.forEach(function(c) { c.classList.remove('is-active'); });
        if (currentFilters.coll === targetColl) {
          currentFilters.coll = 'all';
        } else {
          currentFilters.coll = targetColl;
          card.classList.add('is-active');
        }

        // Update dropdown active state too
        var collDropdownItems = section.querySelectorAll('#swp-coll-dropdown-menu-{{ section_id }} .swp-dropdown-item');
        collDropdownItems.forEach(function(item) {
          var val = (item.getAttribute('data-filter-val') || 'all').toLowerCase();
          item.classList.toggle('is-selected', val === currentFilters.coll);
        });

        applyFilters();

        // Smooth scroll to product grid
        var toolbar = section.querySelector('#swp-toolbar-{{ section_id }}');
        if (toolbar) {
          toolbar.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // 3. Dropdowns Behavior (Toggle Open / Close)
    var dropdowns = section.querySelectorAll('[data-swp-dropdown]');
    dropdowns.forEach(function(dd) {
      var btn = dd.querySelector('.swp-pill-btn');
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = dd.classList.contains('is-open');
        dropdowns.forEach(function(d) { d.classList.remove('is-open'); });
        if (!isOpen) dd.classList.add('is-open');
      });
    });

    document.addEventListener('click', function() {
      dropdowns.forEach(function(d) { d.classList.remove('is-open'); });
    });

    // Dropdown Items Click
    section.querySelectorAll('.swp-dropdown-item').forEach(function(item) {
      item.addEventListener('click', function(e) {
        e.stopPropagation();
        var menu = item.closest('.swp-dropdown-menu');
        var dd = item.closest('.swp-dropdown');
        if (menu) {
          menu.querySelectorAll('.swp-dropdown-item').forEach(function(i) { i.classList.remove('is-selected'); });
          item.classList.add('is-selected');
        }
        if (dd) dd.classList.remove('is-open');

        // Check if Sort or Filter
        var sortVal = item.getAttribute('data-sort');
        if (sortVal) {
          currentFilters.sort = sortVal;
          if (sortLabel) sortLabel.textContent = 'Sort: ' + item.textContent.trim();
        }

        var filterType = item.getAttribute('data-filter-type');
        var filterVal = (item.getAttribute('data-filter-val') || 'all').toLowerCase();
        if (filterType && filterVal) {
          currentFilters[filterType] = filterVal;

          if (filterType === 'coll') {
            collCards.forEach(function(c) {
              var cVal = (c.getAttribute('data-filter-coll') || 'all').toLowerCase();
              c.classList.toggle('is-active', cVal === filterVal && filterVal !== 'all');
            });
          }
        }

        applyFilters();
      });
    });

    // 4. In Stock Checkbox
    if (inStockCheckbox) {
      inStockCheckbox.addEventListener('change', function() {
        currentFilters.inStockOnly = inStockCheckbox.checked;
        applyFilters();
      });
    }

    // 5. View Toggles (4-col vs 2-col)
    var viewBtns = section.querySelectorAll('.swp-view-btn');
    viewBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        viewBtns.forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var view = btn.getAttribute('data-view');
        if (grid) {
          grid.classList.remove('grid--2-col', 'grid--3-col');
          if (view === '2') grid.classList.add('grid--2-col');
          if (view === '3') grid.classList.add('grid--3-col');
        }
      });
    });

    // 6. Filter & Sort Execution Engine
    function applyFilters() {
      if (!grid) return;
      var cards = Array.from(grid.querySelectorAll('.swp-product-card'));
      var visibleCount = 0;

      cards.forEach(function(card) {
        var cardColl = (card.getAttribute('data-coll') || '').toLowerCase();
        var cardColor = (card.getAttribute('data-color') || '').toLowerCase();
        var cardInStock = card.getAttribute('data-instock') === 'true';

        var matchColl = (currentFilters.coll === 'all' || cardColl === currentFilters.coll || cardColl.indexOf(currentFilters.coll) !== -1);
        var matchColor = (currentFilters.color === 'all' || cardColor === currentFilters.color || cardColor.indexOf(currentFilters.color) !== -1);
        var matchStock = (!currentFilters.inStockOnly || cardInStock);

        if (matchColl && matchColor && matchStock) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Sorting
      var sortedCards = cards.filter(function(c) { return c.style.display !== 'none'; });
      sortedCards.sort(function(a, b) {
        var priceA = parseFloat(a.getAttribute('data-price')) || 0;
        var priceB = parseFloat(b.getAttribute('data-price')) || 0;
        var ratingA = parseFloat(a.getAttribute('data-rating')) || 0;
        var ratingB = parseFloat(b.getAttribute('data-rating')) || 0;

        if (currentFilters.sort === 'price-low') return priceA - priceB;
        if (currentFilters.sort === 'price-high') return priceB - priceA;
        if (currentFilters.sort === 'rating') return ratingB - ratingA;
        return 0; // featured default
      });

      sortedCards.forEach(function(card) {
        grid.appendChild(card);
      });

      if (countEl) countEl.textContent = visibleCount;
      renderActiveTags();
    }

    // 7. Active Tags Render
    function renderActiveTags() {
      if (!activeTagsContainer) return;
      var tags = [];

      if (currentFilters.coll !== 'all') {
        var collItem = section.querySelector('#swp-coll-dropdown-menu-{{ section_id }} [data-filter-val="' + currentFilters.coll + '"]');
        var collName = collItem ? collItem.textContent.trim() : currentFilters.coll.toUpperCase();
        tags.push({ key: 'coll', label: collName });
      }
      if (currentFilters.color !== 'all') {
        var colorItem = section.querySelector('#swp-color-dropdown-menu-{{ section_id }} [data-filter-val="' + currentFilters.color + '"]');
        var colorName = colorItem ? colorItem.textContent.trim() : currentFilters.color.charAt(0).toUpperCase() + currentFilters.color.slice(1);
        tags.push({ key: 'color', label: 'Color: ' + colorName });
      }
      if (currentFilters.inStockOnly) {
        tags.push({ key: 'inStockOnly', label: 'In Stock Only' });
      }
      if (currentFilters.sort !== 'featured') {
        tags.push({ key: 'sort', label: 'Sort: ' + currentFilters.sort });
      }

      if (tags.length === 0) {
        activeTagsContainer.style.display = 'none';
        activeTagsContainer.innerHTML = '';
        return;
      }

      activeTagsContainer.style.display = 'flex';
      activeTagsContainer.innerHTML = '';

      tags.forEach(function(tag) {
        var pill = document.createElement('button');
        pill.className = 'swp-tag-pill';
        pill.type = 'button';
        pill.innerHTML = tag.label + ' <span>&times;</span>';
        pill.addEventListener('click', function() {
          if (tag.key === 'inStockOnly') {
            currentFilters.inStockOnly = false;
            if (inStockCheckbox) inStockCheckbox.checked = false;
          } else if (tag.key === 'sort') {
            currentFilters.sort = 'featured';
            if (sortLabel) sortLabel.textContent = 'Sort: Featured';
          } else {
            currentFilters[tag.key] = 'all';
          }
          applyFilters();
        });
        activeTagsContainer.appendChild(pill);
      });

      var clearBtn = document.createElement('button');
      clearBtn.className = 'swp-clear-all';
      clearBtn.type = 'button';
      clearBtn.textContent = 'Clear all';
      clearBtn.addEventListener('click', function() {
        currentFilters.coll = 'all';
        currentFilters.color = 'all';
        currentFilters.inStockOnly = false;
        currentFilters.sort = 'featured';
        if (inStockCheckbox) inStockCheckbox.checked = false;
        if (sortLabel) sortLabel.textContent = 'Sort: Featured';
        collCards.forEach(function(c) { c.classList.remove('is-active'); });
        applyFilters();
      });
      activeTagsContainer.appendChild(clearBtn);
    }

    // 8. Add to Cart AJAX handler
    section.querySelectorAll('.swp-atc-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var variantId = btn.getAttribute('data-variant-id');
        var btnText = btn.querySelector('.swp-btn-text');

        btn.classList.add('is-loading');

        // If default sample variant without ID, simulate instant add
        if (!variantId || variantId === 'default') {
          setTimeout(function() {
            btn.classList.remove('is-loading');
            if (btnText) btnText.textContent = 'Added ✓';
            
            // Try opening cart drawer if present
            var cartDrawer = document.querySelector('cart-drawer');
            if (cartDrawer) {
              if (typeof cartDrawer.open === 'function') cartDrawer.open();
              else cartDrawer.classList.add('active');
            }

            setTimeout(function() {
              if (btnText) btnText.textContent = 'Add To Cart';
            }, 2000);
          }, 600);
          return;
        }

        // Live Shopify /cart/add.js
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          btn.classList.remove('is-loading');
          if (btnText) btnText.textContent = 'Added ✓';

          var cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer) {
            if (typeof cartDrawer.renderContents === 'function') {
              cartDrawer.renderContents(data);
            } else if (typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            } else {
              cartDrawer.classList.add('active');
            }
          }

          setTimeout(function() {
            if (btnText) btnText.textContent = 'Add To Cart';
          }, 2000);
        })
        .catch(function(err) {
          console.error('Add to cart error:', err);
          btn.classList.remove('is-loading');
        });
      });
    });

  })();
</script>

