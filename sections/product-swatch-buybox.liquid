{% comment %}
  Sipwise Theme — Owala-Style Product Swatch Buy Box Section
  Full-viewport pastel background transition on hover & commit,
  dynamic Add to Cart button styling, segmented size capsule,
  and exact Owala reference layout & typography.
{% endcomment %}

{{ 'product-swatch.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-swatch.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_id = section.id
  assign current_product = section.settings.product | default: product
  assign current_variant = current_product.selected_or_first_available_variant

  assign color_option_index = 0
  assign color_option_name = ''
  assign has_color_option = false

  assign size_option_index = 1
  assign size_option_name = ''
  assign has_size_option = false

  for option in current_product.options_with_values
    assign opt_name_lower = option.name | downcase
    if opt_name_lower contains 'color' or opt_name_lower contains 'colour' or opt_name_lower contains 'shade' or opt_name_lower contains 'finish' or opt_name_lower contains 'style'
      assign color_option_index = forloop.index0
      assign color_option_name = option.name
      assign has_color_option = true
    elsif opt_name_lower contains 'size' or opt_name_lower contains 'volume' or opt_name_lower contains 'capacity' or opt_name_lower contains 'oz'
      assign size_option_index = forloop.index0
      assign size_option_name = option.name
      assign has_size_option = true
    endif
  endfor

  if has_color_option == false and current_product.options_with_values.size > 0
    assign color_option_index = 0
    assign color_option_name = current_product.options_with_values[0].name
    assign has_color_option = true
  endif

  assign swatch_blocks = section.blocks | where: 'type', 'color_swatch'
  assign selected_color_value = current_variant.options[color_option_index] | default: ''
  assign selected_size_value = current_variant.options[size_option_index] | default: ''
-%}

{%- style -%}
  #SwatchBuyBox-{{ section_id }} {
    --sbb-container-width: {{ section.settings.container_width | default: 1320 }}px;
    --sbb-padding-y-desktop: {{ section.settings.padding_top_desktop | default: 64 }}px;
    --sbb-padding-y-mobile: {{ section.settings.padding_top_mobile | default: 40 }}px;
    --sbb-grid-gap-desktop: {{ section.settings.grid_gap_desktop | default: 64 }}px;
    --sbb-grid-gap-mobile: {{ section.settings.grid_gap_mobile | default: 36 }}px;
    --sbb-text-color: {{ section.settings.text_color | default: '#0f172a' }};
    --sbb-font-family: {{ section.settings.font_family | default: "'Figtree', sans-serif" }};
  }
{%- endstyle -%}

<section
  id="SwatchBuyBox-{{ section_id }}"
  class="swatch-buybox-section"
  data-swatch-buybox
  data-section-id="{{ section_id }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="swatch-buybox-container">
    {%- if current_product != blank -%}
      <div class="swatch-buybox-grid">
        
        {% comment %} ================= LEFT COLUMN: PRODUCT STAGE & CAROUSEL ================= {% endcomment %}
        <div class="swatch-buybox-stage-wrapper">
          <div class="swatch-buybox-stage">
            <div class="swatch-buybox-image-wrap">
              {%- if has_color_option and current_product.options_with_values[color_option_index].values.size > 0 -%}
                {%- for color_val in current_product.options_with_values[color_option_index].values -%}
                  {%- liquid
                    assign rep_variant = null
                    for v in current_product.variants
                      if v.options[color_option_index] == color_val
                        assign rep_variant = v
                        break
                      endif
                    endfor

                    assign img_obj = rep_variant.featured_image | default: current_product.featured_image
                    assign is_active_img = false
                    if rep_variant.id == current_variant.id or forloop.first and current_variant == blank
                      assign is_active_img = true
                    elsif color_val == selected_color_value
                      assign is_active_img = true
                    endif
                  -%}
                  {%- if img_obj != blank -%}
                    <img
                      src="{{ img_obj | image_url: width: 1000 }}"
                      srcset="{{ img_obj | image_url: width: 500 }} 500w, {{ img_obj | image_url: width: 800 }} 800w, {{ img_obj | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 990px) 440px, 85vw"
                      alt="{{ img_obj.alt | default: current_product.title | escape }} - {{ color_val | escape }}"
                      class="swatch-buybox-img {% if is_active_img %}is-active{% else %}is-inactive{% endif %}"
                      data-variant-id="{{ rep_variant.id }}"
                      data-color-name="{{ color_val | escape }}"
                      width="{{ img_obj.width | default: 800 }}"
                      height="{{ img_obj.height | default: 900 }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      {% if forloop.first %}fetchpriority="high"{% endif %}
                    >
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign fallback_img = current_variant.featured_image | default: current_product.featured_image -%}
                {%- if fallback_img != blank -%}
                  <img
                    src="{{ fallback_img | image_url: width: 1000 }}"
                    srcset="{{ fallback_img | image_url: width: 500 }} 500w, {{ fallback_img | image_url: width: 800 }} 800w, {{ fallback_img | image_url: width: 1200 }} 1200w"
                    sizes="(min-width: 990px) 440px, 85vw"
                    alt="{{ fallback_img.alt | default: current_product.title | escape }}"
                    class="swatch-buybox-img is-active"
                    data-variant-id="{{ current_variant.id }}"
                    width="{{ fallback_img.width | default: 800 }}"
                    height="{{ fallback_img.height | default: 900 }}"
                    loading="eager"
                    fetchpriority="high"
                  >
                {%- endif -%}
              {%- endif -%}
            </div>

            {% comment %} Bottom Carousel Dots & Arrows Navigation (< ● ○ ○ ○ ○ >) {% endcomment %}
            <div class="swatch-buybox-gallery-nav" aria-label="Product image gallery controls">
              <button type="button" class="swatch-buybox-nav-arrow" data-gallery-prev aria-label="Previous image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              
              <div class="swatch-buybox-nav-dots">
                <button type="button" class="swatch-buybox-nav-dot is-active" aria-label="Slide 1"></button>
                <button type="button" class="swatch-buybox-nav-dot" aria-label="Slide 2"></button>
                <button type="button" class="swatch-buybox-nav-dot" aria-label="Slide 3"></button>
                <button type="button" class="swatch-buybox-nav-dot" aria-label="Slide 4"></button>
                <button type="button" class="swatch-buybox-nav-dot" aria-label="Slide 5"></button>
              </div>

              <button type="button" class="swatch-buybox-nav-arrow" data-gallery-next aria-label="Next image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>

          </div>
        </div>

        {% comment %} ================= RIGHT COLUMN: BUY BOX CONTROLS ================= {% endcomment %}
        <div class="swatch-buybox-info">
          
          {% comment %} Title & Registered Symbol {% endcomment %}
          <div class="swatch-buybox-header">
            <h1 class="swatch-buybox-title">
              {{ section.settings.custom_title | default: current_product.title }}
              {%- if section.settings.show_trademark_symbol -%}
                <span class="swatch-buybox-trademark">®</span>
              {%- endif -%}
            </h1>

            {% comment %} Tagline / Subtitle {% endcomment %}
            {%- if section.settings.tagline_text != blank -%}
              <p class="swatch-buybox-tagline">
                {{ section.settings.tagline_text }}
              </p>
            {%- endif -%}
          </div>

          {% comment %} Star Reviews Rating {% endcomment %}
          {%- if section.settings.show_reviews -%}
            <div class="swatch-buybox-reviews">
              <div class="swatch-buybox-stars" aria-label="5 out of 5 stars">
                ★★★★★
              </div>
              <span class="swatch-buybox-review-count">
                {{ section.settings.reviews_count_text | default: '33135 reviews' }}
              </span>
            </div>
          {%- endif -%}

          {% comment %} Size Selector (Segmented Capsule Bar) {% endcomment %}
          {%- if has_size_option and current_product.options_with_values[size_option_index].values.size > 0 -%}
            <div class="swatch-buybox-size-group">
              <p class="swatch-buybox-group-label">{{ size_option_name }}</p>
              <div class="swatch-buybox-size-capsule" role="radiogroup" aria-label="{{ size_option_name }} selection">
                {%- for size_val in current_product.options_with_values[size_option_index].values -%}
                  {%- assign is_active_size = false -%}
                  {%- if current_variant.options[size_option_index] == size_val or forloop.first and current_variant.options[size_option_index] == blank -%}
                    {%- assign is_active_size = true -%}
                  {%- endif -%}
                  <button
                    type="button"
                    class="swatch-buybox-size-btn {% if is_active_size %}is-active{% endif %}"
                    role="radio"
                    aria-checked="{% if is_active_size %}true{% else %}false{% endif %}"
                    aria-pressed="{% if is_active_size %}true{% else %}false{% endif %}"
                    data-option-index="{{ size_option_index }}"
                    data-option-value="{{ size_val | escape }}"
                  >
                    {{ size_val }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- elsif section.settings.mock_sizes != blank -%}
            {% comment %} Fallback sizes if product only has 1 size {% endcomment %}
            <div class="swatch-buybox-size-group">
              <p class="swatch-buybox-group-label">Size</p>
              <div class="swatch-buybox-size-capsule" role="radiogroup" aria-label="Size selection">
                {%- assign mock_size_list = section.settings.mock_sizes | split: ',' -%}
                {%- for mock_s in mock_size_list -%}
                  {%- assign s_clean = mock_s | strip -%}
                  <button
                    type="button"
                    class="swatch-buybox-size-btn {% if forloop.first %}is-active{% endif %}"
                    role="radio"
                    aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                  >
                    {{ s_clean }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {% comment %} Color Name & Swatches Grid {% endcomment %}
          {%- if has_color_option and current_product.options_with_values[color_option_index].values.size > 0 -%}
            <div class="swatch-buybox-color-group">
              <p class="swatch-buybox-color-title">
                {{ selected_color_value | default: current_product.options_with_values[color_option_index].values[0] }}
              </p>

              <div class="swatch-buybox-swatches-grid" role="radiogroup" aria-label="Color options">
                {%- for color_val in current_product.options_with_values[color_option_index].values -%}
                  {%- liquid
                    assign rep_variant = null
                    for v in current_product.variants
                      if v.options[color_option_index] == color_val
                        assign rep_variant = v
                        break
                      endif
                    endfor

                    # Color determination
                    assign resolved_hex = null
                    assign custom_bg_color = null
                    assign custom_btn_color = null

                    if current_product.metafields.custom.swatch_colors != blank
                      assign mf_colors = current_product.metafields.custom.swatch_colors
                      if mf_colors[color_val] != blank
                        assign resolved_hex = mf_colors[color_val]
                      endif
                    endif

                    if resolved_hex == null
                      for block in swatch_blocks
                        assign block_label_clean = block.settings.label | strip | downcase
                        assign color_val_clean = color_val | strip | downcase
                        if block_label_clean == color_val_clean
                          assign resolved_hex = block.settings.swatch_color
                          assign custom_bg_color = block.settings.bg_color
                          assign custom_btn_color = block.settings.btn_color
                          break
                        endif
                      endfor
                    endif

                    # Reference-Exact Color Dictionary
                    if resolved_hex == null
                      assign c_lower = color_val | downcase | strip
                      if c_lower contains 'out of the blue' or c_lower contains 'blue' or c_lower contains 'periwinkle'
                        assign resolved_hex = '#a5b4fc'
                        assign custom_bg_color = '#dce4f7'
                        assign custom_btn_color = '#9bb1e4'
                      elsif c_lower contains 'peach' or c_lower contains 'peach of mind'
                        assign resolved_hex = '#e99f7d'
                        assign custom_bg_color = '#fae2d4'
                        assign custom_btn_color = '#e99f7d'
                      elsif c_lower contains 'rose' or c_lower contains 'rose quartz' or c_lower contains 'blush'
                        assign resolved_hex = '#d88fa5'
                        assign custom_bg_color = '#f8e5e8'
                        assign custom_btn_color = '#d88fa5'
                      elsif c_lower contains 'hot pink' or c_lower contains 'magenta'
                        assign resolved_hex = '#ec4899'
                        assign custom_bg_color = '#fce7f3'
                        assign custom_btn_color = '#ec4899'
                      elsif c_lower contains 'coral' or c_lower contains 'electric coral'
                        assign resolved_hex = '#fb7185'
                        assign custom_bg_color = '#ffe4e6'
                        assign custom_btn_color = '#fb7185'
                      elsif c_lower contains 'midnight' or c_lower contains 'black'
                        assign resolved_hex = '#1e293b'
                        assign custom_bg_color = '#f1f5f9'
                        assign custom_btn_color = '#1e293b'
                      elsif c_lower contains 'white' or c_lower contains 'marshmallow'
                        assign resolved_hex = '#ffffff'
                        assign custom_bg_color = '#f8fafc'
                        assign custom_btn_color = '#64748b'
                      elsif c_lower contains 'teal' or c_lower contains 'mint'
                        assign resolved_hex = '#5eead4'
                        assign custom_bg_color = '#e6fffa'
                        assign custom_btn_color = '#14b8a6'
                      elsif c_lower contains 'sage' or c_lower contains 'green'
                        assign resolved_hex = '#a7f3d0'
                        assign custom_bg_color = '#ecfdf5'
                        assign custom_btn_color = '#10b981'
                      elsif c_lower contains 'yellow' or c_lower contains 'lemon'
                        assign resolved_hex = '#fef08a'
                        assign custom_bg_color = '#fefce8'
                        assign custom_btn_color = '#eab308'
                      elsif c_lower contains 'lavender' or c_lower contains 'purple'
                        assign resolved_hex = '#c4b5fd'
                        assign custom_bg_color = '#f5f3ff'
                        assign custom_btn_color = '#8b5cf6'
                      else
                        assign resolved_hex = '#93c5fd'
                        assign custom_bg_color = '#eff6ff'
                        assign custom_btn_color = '#3b82f6'
                      endif
                    endif

                    assign is_active_swatch = false
                    if rep_variant.id == current_variant.id
                      assign is_active_swatch = true
                    elsif color_val == selected_color_value
                      assign is_active_swatch = true
                    endif
                  -%}

                  <button
                    type="button"
                    class="swatch-buybox-swatch {% if is_active_swatch %}is-active{% endif %} {% if rep_variant.available == false %}is-sold-out{% endif %}"
                    role="radio"
                    aria-checked="{% if is_active_swatch %}true{% else %}false{% endif %}"
                    aria-pressed="{% if is_active_swatch %}true{% else %}false{% endif %}"
                    aria-label="{{ color_val | escape }}"
                    data-color-name="{{ color_val | escape }}"
                    data-color-hex="{{ resolved_hex }}"
                    data-bg-color="{{ custom_bg_color }}"
                    data-btn-color="{{ custom_btn_color }}"
                    data-variant-id="{{ rep_variant.id }}"
                    data-price="{{ rep_variant.price | money }}"
                    data-available="{{ rep_variant.available }}"
                    style="--swatch-btn-color: {{ resolved_hex }};"
                    tabindex="0"
                  ></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {% comment %} Price & Customize Row {% endcomment %}
          <div class="swatch-buybox-price-row">
            <span class="swatch-buybox-price-current">
              {{ current_variant.price | money }}
            </span>
            {%- if section.settings.show_customize_button -%}
              <a href="{{ section.settings.customize_url | default: '#' }}" class="swatch-buybox-customize-btn">
                {{ section.settings.customize_btn_text | default: 'Customize' }}
              </a>
            {%- endif -%}
          </div>

          {% comment %} Add to Cart & Quantity Row {% endcomment %}
          <div class="swatch-buybox-atc-wrap">
            {%- assign product_form_id = 'SwatchBuyBoxForm-' | append: section_id -%}
            {%- form 'product', current_product, id: product_form_id, class: 'swatch-buybox-form', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
              
              <div class="swatch-buybox-atc-row">
                <button
                  type="submit"
                  name="add"
                  class="swatch-buybox-atc-btn"
                  {% unless current_variant.available %}disabled="disabled"{% endunless %}
                  data-default-text="{{ section.settings.atc_btn_text | default: 'Add to cart' }}"
                >
                  <span class="swatch-buybox-spinner" aria-hidden="true"></span>
                  <span class="swatch-buybox-atc-text">
                    {%- if current_variant.available -%}
                      {{ section.settings.atc_btn_text | default: 'Add to cart' }}
                    {%- else -%}
                      Sold Out
                    {%- endif -%}
                  </span>
                </button>

                <div class="swatch-buybox-qty-wrap">
                  <button type="button" class="swatch-buybox-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
                  <input
                    type="number"
                    name="quantity"
                    class="swatch-buybox-qty-input"
                    value="1"
                    min="1"
                    aria-label="Quantity"
                  >
                  <button type="button" class="swatch-buybox-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
                </div>
              </div>
            {%- endform -%}

            <div class="swatch-buybox-error-message" role="alert" hidden></div>
          </div>

          {% comment %} Footer Links (Returns | Warranty | FAQs) {% endcomment %}
          {%- if section.settings.show_footer_links -%}
            <div class="swatch-buybox-footer-links">
              <a href="{{ section.settings.link_1_url | default: '#' }}">{{ section.settings.link_1_text | default: '30-Day Returns' }}</a>
              <span class="swatch-buybox-divider-pipe">|</span>
              <a href="{{ section.settings.link_2_url | default: '#' }}">{{ section.settings.link_2_text | default: 'Limited Lifetime Warranty' }}</a>
              <span class="swatch-buybox-divider-pipe">|</span>
              <a href="{{ section.settings.link_3_url | default: '#' }}">{{ section.settings.link_3_text | default: 'FAQs' }}</a>
            </div>
          {%- endif -%}

          {% comment %} Shop Pay / Installment Text {% endcomment %}
          {%- if section.settings.show_installments -%}
            <p class="swatch-buybox-installments">
              Pay over time for orders over $35.00 with <span class="swatch-buybox-shoppay-badge">shop Pay</span> <a href="#">Learn more</a>
            </p>
          {%- endif -%}

        </div>

      </div>

      {% comment %} Embedded JSON for Variant Data {% endcomment %}
      <script type="application/json" class="swatch-buybox-variants-data">
        {{ current_product.variants | json }}
      </script>

    {%- else -%}
      <div style="padding: 60px 20px; text-align: center; background: #f8fafc; border-radius: 20px; border: 2px dashed #cbd5e1;">
        <h2 style="font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 8px;">Product Swatch Buy Box</h2>
        <p style="color: #64748b; font-size: 15px; max-width: 480px; margin: 0 auto 20px;">
          Select a product in the section settings to display its interactive color swatches and live buy box.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Swatch Buy Box",
  "tag": "section",
  "class": "section-product-swatch-buybox",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave blank on product templates to automatically use the page's product."
    },
    {
      "type": "header",
      "content": "Typography & Headings"
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Font Family CSS",
      "default": "'Figtree', sans-serif"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom Heading (Optional)",
      "info": "Leave blank to use product title"
    },
    {
      "type": "checkbox",
      "id": "show_trademark_symbol",
      "label": "Show Registered Symbol (®)",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline / Subtitle",
      "default": "Award winning. Leak-proof. 24 hours cold."
    },
    {
      "type": "header",
      "content": "Reviews & Social Proof"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Star Reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "Reviews Text",
      "default": "33135 reviews"
    },
    {
      "type": "header",
      "content": "Sizes & Customization"
    },
    {
      "type": "text",
      "id": "mock_sizes",
      "label": "Fallback Size List (comma separated)",
      "default": "24oz, 32oz, 40oz",
      "info": "Used if product does not have multiple sizes"
    },
    {
      "type": "checkbox",
      "id": "show_customize_button",
      "label": "Show Customize Pill Button",
      "default": false
    },
    {
      "type": "text",
      "id": "customize_btn_text",
      "label": "Customize Button Text",
      "default": "Customize"
    },
    {
      "type": "url",
      "id": "customize_url",
      "label": "Customize Link URL"
    },
    {
      "type": "header",
      "content": "Add to Cart Button"
    },
    {
      "type": "text",
      "id": "atc_btn_text",
      "label": "Add to Cart Text",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Footer Value Links"
    },
    {
      "type": "checkbox",
      "id": "show_footer_links",
      "label": "Show Footer Trust Links",
      "default": true
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 Text",
      "default": "30-Day Returns"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 Text",
      "default": "Limited Lifetime Warranty"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Link 3 Text",
      "default": "FAQs"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "checkbox",
      "id": "show_installments",
      "label": "Show Shop Pay Installments Note",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout Sizing"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Y",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Y",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "color_swatch",
      "name": "Color Swatch",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Color Name / Option Value",
