{% comment %}
  Owala Hero Banner Section
{% endcomment %}
<style>
  .owala-hero {
    position: relative;
    width: 100%;
    min-height: 520px;
    background: {{ section.settings.bg_gradient }};
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0 0 32px 32px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .owala-hero__container {
    max-width: 1200px;
    width: 100%;
    padding: 3rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media screen and (max-width: 768px) {
    .owala-hero {
      min-height: 440px;
      border-radius: 0 0 24px 24px;
    }
    .owala-hero__container {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 2rem 1.25rem;
    }
  }

  .owala-hero__badge {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    background-color: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .owala-hero__heading {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.08;
    color: {{ section.settings.text_color }};
    margin: 0 0 1.25rem 0;
  }

  .owala-hero__subheading {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    color: {{ section.settings.subtext_color }};
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .owala-hero__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media screen and (max-width: 768px) {
    .owala-hero__buttons {
      justify-content: center;
    }
  }

  .owala-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 2.2rem;
    font-size: 1.05rem;
    font-weight: 800;
    border-radius: 9999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .owala-hero__btn--primary {
    background-color: {{ section.settings.btn_primary_bg }};
    color: {{ section.settings.btn_primary_text }};
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .owala-hero__btn--primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .owala-hero__btn--secondary {
    background-color: transparent;
    color: {{ section.settings.text_color }};
    border: 2.5px solid {{ section.settings.text_color }};
  }

  .owala-hero__btn--secondary:hover {
    transform: translateY(-2px);
    background-color: rgba(255, 255, 255, 0.15);
  }

  .owala-hero__media-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 420px;
    background: {{ section.settings.media_placeholder_bg }};
    border-radius: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #4a5568;
    border: 2px dashed rgba(0, 0, 0, 0.1);
    box-shadow: 0 16px 40px rgba(0,0,0,0.06);
    position: relative;
    overflow: hidden;
  }

  .owala-hero__media-placeholder svg {
    width: 80px;
    height: 80px;
    opacity: 0.4;
    margin-bottom: 0.75rem;
  }
</style>

<div class="content-for-grouping {{ section.settings.visibility }}">
  <section class="owala-hero">
    <div class="owala-hero__container">
      <div class="owala-hero__content">
        {%- if section.settings.badge_text != blank -%}
          <span class="owala-hero__badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}
        <h1 class="owala-hero__heading">{{ section.settings.heading }}</h1>
        <p class="owala-hero__subheading">{{ section.settings.subheading }}</p>
        <div class="owala-hero__buttons">
          {%- if section.settings.btn_primary_label != blank -%}
            <a href="{{ section.settings.btn_primary_url }}" class="owala-hero__btn owala-hero__btn--primary">
              {{ section.settings.btn_primary_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.btn_secondary_label != blank -%}
            <a href="{{ section.settings.btn_secondary_url }}" class="owala-hero__btn owala-hero__btn--secondary">
              {{ section.settings.btn_secondary_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
      <div class="owala-hero__media">
        {%- if section.settings.hero_image != blank -%}
          <img
            src="{{ section.settings.hero_image | image_url: width: 800 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
            width="800"
            height="800"
            class="owala-card-rounded"
          >
        {%- else -%}
          <div class="owala-hero__media-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="4" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
            <span style="font-weight: 700; font-size: 0.95rem;">[ HERO BANNER IMAGE PLACEHOLDER ]</span>
            <span style="font-size: 0.8rem; opacity: 0.7; margin-top: 0.25rem;">Upload your banner image here</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Owala Hero Banner",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "always-display", "label": "Always" },
        { "value": "hide-desktop", "label": "Hide on Desktop" },
        { "value": "hide-mobile", "label": "Hide on Mobile" }
      ],
      "default": "always-display",
      "label": "Visibility"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "LIMITED EDITION DROP"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background",
      "default": "#ff5c8d"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Do more than just sip."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meet the bottle designed to stay cold, stay clean, and turn heads wherever you go."
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary Button Label",
      "default": "Shop FreeSip®"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary Button URL",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Primary Button Color",
      "default": "#2d3640"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Primary Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary Button Label",
      "default": "Explore Bundles"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary Button URL",
      "default": "/collections/all"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient / Color",
      "default": "linear-gradient(135deg, #eef7fc 0%, #e3f2fd 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#475569"
    },
    {
      "type": "color",
      "id": "media_placeholder_bg",
      "label": "Placeholder Media BG Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Owala Hero Banner"
    }
  ]
}
{% endschema %}
