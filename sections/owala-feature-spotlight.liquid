<style>
  .owala-features {
    padding: 4rem 1.5rem;
    background-color: {{ section.settings.bg_color }};
  }

  .owala-features__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }

  .owala-features__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: {{ section.settings.title_color }};
    margin: 0 0 0.75rem 0;
  }

  .owala-features__subtitle {
    font-size: 1.15rem;
    font-weight: 500;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
  }

  .owala-features__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media screen and (max-width: 900px) {
    .owala-features__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .owala-feature-card {
    background: {{ section.settings.card_bg }};
    border-radius: 24px;
    padding: 2.5rem 1.75rem;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: transform 0.25 ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .owala-feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
  }

  .owala-feature-card__icon-box {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: {{ section.settings.icon_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    color: {{ section.settings.icon_color }};
  }

  .owala-feature-card__icon-box svg {
    width: 40px;
    height: 40px;
  }

  .owala-feature-card__title {
    font-size: 1.4rem;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0 0 0.75rem 0;
  }

  .owala-feature-card__desc {
    font-size: 1rem;
    line-height: 1.6;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
  }

  .owala-feature-card__media-placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #f8fafc;
    border-radius: 16px;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px dashed #cbd5e1;
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>

<div class="content-for-grouping {{ section.settings.visibility }}">
<section class="owala-features">
  <div class="owala-features__header">
    <h2 class="owala-features__title">{{ section.settings.heading }}</h2>
    <p class="owala-features__subtitle">{{ section.settings.subheading }}</p>
  </div>
  <div class="owala-features__grid">
    {%- for block in section.blocks -%}
      <div class="owala-feature-card" {{ block.shopify_attributes }}>
        <div class="owala-feature-card__icon-box">
          {%- if block.settings.icon_svg != blank -%}
            {{ block.settings.icon_svg }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          {%- endif -%}
        </div>
        <h3 class="owala-feature-card__title">{{ block.settings.title }}</h3>
        <p class="owala-feature-card__desc">{{ block.settings.description }}</p>
        
        <div class="owala-feature-card__media-placeholder">
          <span>[ FEATURE MEDIA PLACEHOLDER ]</span>
          <span style="font-size: 0.75rem; opacity: 0.75; font-weight: 500;">Upload illustration/GIF</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Owala Feature Spotlight",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "always-display", "label": "Always" },
        { "value": "hide-desktop", "label": "Hide on Desktop" },
        { "value": "hide-mobile", "label": "Hide on Mobile" }
      ],
      "default": "always-display",
      "label": "Visibility"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What makes it special?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered for maximum hydration and effortless everyday style."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subheading/Description Color",
      "default": "#475569"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Circle BG",
      "default": "#e0f2fe"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#0284c7"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FreeSip® 2-in-1 Spout"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Sip upright through the built-in straw or tilt back to swig from the wide-mouth opening."
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG Icon (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Owala Feature Spotlight",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "2-in-1 FreeSip® Spout",
            "description": "Sip upright through the built-in straw or tilt back to swig from the wide-mouth opening."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Triple-Layer Insulation",
            "description": "Keeps your water ice-cold for up to 24 hours without sweating."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Leak-Proof Lock",
            "description": "Push-button open lid with a carry loop that doubles as a security lock."
          }
        }
      ]
    }
  ]
}
{% endschema %}
