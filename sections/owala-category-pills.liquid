<style>
  .owala-pills-section {
    padding: 1.25rem 0;
    background-color: {{ section.settings.bg_color }};
  }

  .owala-pills__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .owala-pills__container::-webkit-scrollbar {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .owala-pills__container {
      justify-content: flex-start;
      padding: 0 1rem;
    }
  }

  .owala-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.4rem;
    background-color: {{ section.settings.pill_bg }};
    color: {{ section.settings.pill_text }};
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    border: 1.5px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 0.2s ease;
  }

  .owala-pill:hover, .owala-pill--active {
    background-color: {{ section.settings.pill_active_bg }};
    color: {{ section.settings.pill_active_text }};
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  }

  .owala-pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: currentColor;
  }
</style>

<div class="owala-pills-section content-for-grouping {{ section.settings.visibility }}">
  <div class="owala-pills__container">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url }}" class="owala-pill{% if block.settings.highlight %} owala-pill--active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.show_dot -%}
          <span class="owala-pill__dot"></span>
        {%- endif -%}
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Owala Category Pills",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "always-display", "label": "Always" },
        { "value": "hide-desktop", "label": "Hide on Desktop" },
        { "value": "hide-mobile", "label": "Hide on Mobile" }
      ],
      "default": "always-display",
      "label": "Visibility"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Pill Background",
      "default": "#f1f5f9"
    },
    {
      "type": "color",
      "id": "pill_text",
      "label": "Pill Text Color",
      "default": "#334155"
    },
    {
      "type": "color",
      "id": "pill_active_bg",
      "label": "Pill Hover/Active BG",
      "default": "#2d3640"
    },
    {
      "type": "color",
      "id": "pill_active_text",
      "label": "Pill Hover/Active Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FreeSip® Family"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/collections/all"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight Pill",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_dot",
          "label": "Show Indicator Dot",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Owala Category Pills",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "title": "FreeSip® Family",
            "highlight": true,
            "show_dot": true
          }
        },
        {
          "type": "pill",
          "settings": {
            "title": "Color Drop 💧"
          }
        },
        {
          "type": "pill",
          "settings": {
            "title": "Tumbler 40oz"
          }
        },
        {
          "type": "pill",
          "settings": {
            "title": "Customize"
          }
        },
        {
          "type": "pill",
          "settings": {
            "title": "New Arrivals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
