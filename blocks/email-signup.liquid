{% if block.settings.input_styling == 'custom' %}
  <style>
    #EmailSignupBlock-{{ block.id }} {
      --inputs-bg-color: var(--color-base-{{ block.settings.custom_input_color_scheme }});
      --inputs-border-color: var(--color-base-{{ block.settings.custom_input_border_color }});
      --inputs-text-color: var(--color-base-{{ block.settings.custom_input_text_color }});
      --inputs-overlay-color: var(--color-base-{{ block.settings.custom_input_overlay_color }});
      --inputs-overlay-opacity: {{ block.settings.custom_input_overlay_opacity | divided_by: 100.0 }};
      --inputs-hover-overlay-opacity: {{ block.settings.custom_input_hover_overlay_opacity | divided_by: 100.0 }};
      --inputs-hover-border-opacity: {{ block.settings.custom_input_hover_border_opacity | divided_by: 100.0 }};
      --inputs-border-width: {{ block.settings.custom_input_border_thickness }}px;
      --inputs-border-opacity: {{ block.settings.custom_input_border_opacity | divided_by: 100.0 }};
      --inputs-radius: {{ block.settings.custom_input_radius }}px;
      --inputs-radius-outset: {% if block.settings.custom_input_radius > 0 %}{{ block.settings.custom_input_radius | plus: block.settings.custom_input_border_thickness }}{% else %}0{% endif %}px;
      --inputs-shadow-opacity: {{ block.settings.custom_input_shadow_opacity | divided_by: 100.0 }};
      --inputs-shadow-horizontal-offset: {{ block.settings.custom_input_shadow_horizontal_offset }}px;
      --inputs-shadow-vertical-offset: {{ block.settings.custom_input_shadow_vertical_offset }}px;
      --inputs-shadow-blur-radius: {{ block.settings.custom_input_shadow_blur }}px;
      --inputs-margin-offset: {% if block.settings.custom_input_shadow_vertical_offset != 0 and block.settings.custom_input_shadow_opacity > 0 %}{{ block.settings.custom_input_shadow_vertical_offset | abs }}{% else %}0{% endif %}px;
    }
  </style>
{% endif %}
<div id="EmailSignupBlock-{{ block.id }}"{% if block.settings.input_styling != 'transparent' %} class="inputs-styled"{% endif %}>
  <div class="footer-block__details-content footer-block__details-content-mb rte">
    {{ block.settings.subtext }}
  </div>
  {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter-form__field-wrapper">
      <div class="field">
        <input
          id="NewsletterForm--{{ section.id }}"
          type="email"
          name="contact[email]"
          class="field__input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="ContactFooter-error"
          {% elsif form.posted_successfully? %}
            aria-describedby="ContactFooter-success"
          {% endif %}
          placeholder="{{ 'newsletter.label' | t }}"
          required
        >
        <label class="field__label" for="NewsletterForm--{{ section.id }}">
          {{ 'newsletter.label' | t }}
        </label>
        {% if block.settings.button_type == 'arrow' %}
          <button
            type="submit"
            class="newsletter-form__button field__button"
            name="commit"
            id="Subscribe"
            aria-label="{{ 'newsletter.button_label' | t }}"
          >
            {% render 'icon-arrow' %}
          </button>
        {% endif %}
      </div>
      {%- if form.errors -%}
        <small class="newsletter-form__message form__message" id="ContactFooter-error">
          {%- render 'icon-error' -%}
          {{- form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email -}}
        </small>
      {%- endif -%}
    </div>
    {% if block.settings.button_type == 'solid' %}
      <button
        type="submit"
        class="button newsletter__solid-btn button--full-width{% if block.settings.button_style_secondary %} button--secondary{% endif %}"
        name="commit"
        id="Subscribe"
        aria-label="{{ 'newsletter.button_label' | t }}"
      >
        {{ block.settings.button_label }}
      </button>
    {% endif %}
    {%- if form.posted_successfully? -%}
      <h3
        class="newsletter-form__message newsletter-form__message--success form__message"
        id="ContactFooter-success"
        tabindex="-1"
        autofocus
      >
        {% render 'icon-success' -%}
        {{- 'newsletter.success' | t }}
      </h3>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Email signup",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Subscribe to our emails",
      "label": "t:sections.footer.blocks.link_list.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "default": "<p>A short sentence encouraging customers to subscribe to your newsletter.</p>",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "button_type",
      "options": [
        {
          "value": "arrow",
          "label": "Arrow button"
        },
        {
          "value": "solid",
          "label": "Solid button"
        }
      ],
      "default": "solid",
      "label": "Submit button type"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Solid button label",
      "default": "Sign up"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "t:sections.slideshow.blocks.slide.settings.secondary_style.label",
      "default": false
    },
    {
      "type": "header",
      "content": "Inputs"
    },
    {
      "type": "select",
      "id": "input_styling",
      "label": "Input styling",
      "info": "Configure the theme-wide preset in Theme settings > Inputs.",
      "options": [
        { "value": "transparent", "label": "Transparent" },
        { "value": "theme", "label": "Theme settings preset" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "custom_input_color_scheme",
      "label": "Background color",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Text" }
      ],
      "default": "background-1",
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_input_border_color",
      "label": "Border color",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "text", "label": "Text" }
      ],
      "default": "accent-1",
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_input_text_color",
      "label": "Text color",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "text", "label": "Text" }
      ],
      "default": "text",
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_input_overlay_color",
      "label": "Overlay color",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "text", "label": "Text" }
      ],
      "default": "accent-1",
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_overlay_opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Background overlay opacity",
      "default": 6,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_border_thickness",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Border opacity",
      "default": 25,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 6,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_shadow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Shadow opacity",
      "default": 0,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_shadow_horizontal_offset",
      "min": -12,
      "max": 12,
      "step": 2,
      "unit": "px",
      "label": "Shadow horizontal offset",
      "default": 0,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_shadow_vertical_offset",
      "min": -12,
      "max": 12,
      "step": 2,
      "unit": "px",
      "label": "Shadow vertical offset",
      "default": 0,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_shadow_blur",
      "min": 0,
      "max": 20,
      "step": 5,
      "unit": "px",
      "label": "Shadow blur",
      "default": 0,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_hover_overlay_opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Hover overlay opacity",
      "default": 10,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_input_hover_border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hover border opacity",
      "default": 55,
      "visible_if": "{{ block.settings.input_styling == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top",
      "min": 0,
      "max": 45,
      "step": 3,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 45,
      "step": 3,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Email signup"
    }
  ]
}
{% endschema %}
